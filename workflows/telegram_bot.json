        "id": "http-create-docs-030",
        "name": "Create Docs",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [1050, 1000]
      },
      {
        "parameters": {
          "language": "javaScript",
          "jsCode": "const docId = $json.document_id;\nconst response = await this.helpers.httpRequest({\n  method: 'GET',\n  url: 'http://backend:8000/api/documents/' + docId + '/pdf',\n  encoding: 'arraybuffer',\n});\nconst buffer = Buffer.from(response);\nconst pdfFilename = ($json.filename || 'document.md').replace('.md', '.pdf');\nconst binaryData = await this.helpers.prepareBinaryData(buffer, pdfFilename, 'application/pdf');\nreturn [{ json: { document_id: docId, topic: $json.topic, filename: pdfFilename }, binary: { pdfData: binaryData } }];"
        },
        "id": "code-download-pdf-033",
        "name": "Download PDF",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1250, 1000]

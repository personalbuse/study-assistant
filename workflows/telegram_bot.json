        "parameters": {
          "language": "javaScript",
          "jsCode": "const text = $node['Telegram Trigger'].json.message.text;\nconst topic = text.replace(/^\\/create podcast\\s*/i, '').trim();\nreturn [{ json: { topic } }];"
        },
        "id": "code-extract-createpodcast-029",
        "name": "Extract Create Podcast Topic",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [850, 1100]
      },

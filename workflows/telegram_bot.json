        "parameters": {
          "method": "POST",
          "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendDocument",
          "sendBody": true,
          "contentType": "multipart-form-data",
          "bodyParameters": {
            "parameters": [
              {
                "name": "chat_id",
                "value": "={{ $node['Telegram Trigger'].json.message.chat.id }}",
                "parameterType": "formData"
              },
              {
                "name": "document",
                "inputDataFieldName": "pdfData",
                "parameterType": "formBinaryData"
              },
              {
                "name": "caption",
                "value": "={{ $json.topic }}\n\n📄 Documento creado con ID: {{ $json.document_id }}\nUsa /docs list para verlo\nUsa /podcast gen {{ $json.document_id }} para generar podcast",
                "parameterType": "formData"
              }
            ]
          },
          "options": {}
        },

# API Keys
GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GOOGLE_API_KEY=your_google_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OWNER_ID=your_telegram_owner_id

# Ngrok (opcional — comenta el servicio en docker-compose si no lo usas)
NGROK_AUTHTOKEN=your_ngrok_token
NGROK_DOMAIN=your_domain.ngrok-free.dev

# Models
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TTS_MODEL=gemini-2.5-flash-preview-tts

# Database (Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# n8n (usar IP pública de la VPS o dominio)
N8N_HOST=tu_ip_vps_o_dominio
N8N_PROTOCOL=http
WEBHOOK_URL=http://tu_ip_vps_o_dominio:5678

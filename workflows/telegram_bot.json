          "jsCode": "const text = $node['Telegram Trigger'].json.message.text;\nconst topic = text.replace(/^\\/create docs\\s*/i, '').trim();\nreturn [{ json: { topic } }];"
        },
        "id": "code-extract-createdocs-028",
        "name": "Extract Create Docs Topic",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [850, 1000]
